UART_TxChar(10);
UART_putst("Motor1 OFF");
UART_TxChar(13);
UART_TxChar(10);
UART_putst("Pneumatic OFF");
UART_TxChar(13);
UART_TxChar(10);
UART_putst("Motor2 ON...");
UART_TxChar(13);
UART_TxChar(10);
UART_putst("********");
UART_TxChar(13);
UART_TxChar(10);
UART_TxChar(13);
UART_TxChar(10);
UART_putst("Waiting for end button...");
UART_TxChar(13);
UART_TxChar(10);
}
}

while(number!=5);
PORTCbits.RC5 = 0;
PORTCbits.RC4 = 0;
PORTAbits.RA0 = 1;
UART_putst("GAME OVER...");
UART_TxChar(13);
UART_TxChar(10);
UART_putst("********************************************************");
UART_TxChar(13);
UART_TxChar(10);
UART_putst("********************************************************");
UART_TxChar(13);
UART_TxChar(10);
UART_putst("********************************************************");
UART_TxChar(13);
UART_TxChar(10);
_delay((unsigned long)((800)*(4000000/4000.0)));
PORTAbits.RA0 = 0;



}
}
