# 376
void Timer2_Setup(){
T2CONbits.TOUTPS = 0b0011;
T2CONbits.T2CKPS = 0b01;
TMR2 = 0x83;
PR2 = 0xff;
INTCONbits.GIE = 1;
INTCONbits.PEIE = 1;
PIE1bits.TMR2IE = 1;
PIR1bits.TMR2IF = 0;
T2CONbits.TMR2ON = 1;
}

# 391
void Timer2_Reset(){
unsigned char i = 0;
T2CONbits.TMR2ON = 0;
TMR2 = 0x83;
sekunde = 0;
sekunde_pass = 0;
stotinke = 0;
time_over = 0;
T2CONbits.TMR2ON = 1;
}

# 405
void Timer0_Setup(){
OPTION_REGbits.PSA = 0;
OPTION_REGbits.T0CS = 0;
OPTION_REGbits.PS = 0b000;
TMR0 = 0x6;
INTCONbits.T0IE = 1;
INTCONbits.T0IF = 0;
}

# 417
void output_v(unsigned char datax,unsigned char value){
if(datax==1){
PORTBbits.RB7 = value;
}
else if(datax==2){
PORTBbits.RB6 = value;
}
else if(datax==3){
PORTBbits.RB5 = value;
}
else if(datax==4){
PORTBbits.RB4 = value;
}
else if(datax==5){
PORTBbits.RB3 = value;
}
else if(datax==6){
PORTBbits.RB2 = value;
}
else if(datax==7){
PORTBbits.RB1 = value;
}
else if(datax==8){
PORTBbits.RB0 = value;
}
else if(datax==9){
PORTCbits.RC5 = value;
}
else if(datax==10){
PORTCbits.RC4 = value;
}
else if(datax==11){
PORTAbits.RA5 = value;
}
else if(datax==12){
PORTAbits.RA4 = value;
}
}

